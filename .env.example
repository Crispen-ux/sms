# ════════════════════════════════════════════════════════════════════════
# Cretek SchoolOS — environment template for a NEW school installation.
#
#   cp .env.example .env   then fill in every value for this school.
#
# This file is a template only: it contains placeholders, never real
# credentials. The real .env is per-installation, contains secrets and must
# never be committed to git or copied between schools unchanged.
# ════════════════════════════════════════════════════════════════════════

# ── Database (REQUIRED) ──────────────────────────────────────────────────
# Dedicated PostgreSQL database for THIS school. Each school gets its own
# database — never point two installations at the same database.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/schoolos_db?schema=public"

# ── Auth (REQUIRED) ──────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32   (keep it private, rotating it
# invalidates existing sessions)
AUTH_SECRET="replace-with-a-long-random-string"
# Public URL of this installation (used by NextAuth callbacks/redirects)
NEXTAUTH_URL="http://localhost:3000"

# ── App URL (REQUIRED) ───────────────────────────────────────────────────
# Canonical URL used for SEO metadata, canonical links and the sitemap.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Product identity (optional) ──────────────────────────────────────────
# Defaults live in src/config/product.ts. Each variable also has a
# NEXT_PUBLIC_ variant (e.g. NEXT_PUBLIC_PRODUCT_NAME) that overrides it for
# client-visible surfaces — set the NEXT_PUBLIC_ form if the value must be
# correct in the browser, the plain form for server-side-only overrides.
PRODUCT_NAME="Cretek SchoolOS"
PRODUCT_VERSION="1.0.0"
COMPANY_NAME="Cretek"
COMPANY_WEBSITE="https://cretekgroup.co.za"
SUPPORT_EMAIL="info@cretekgroup.co.za"
# Path or URL to the product logo (unbranded surfaces)
PRODUCT_LOGO="/favicon.svg"
# Default brand colours (hex). Overridable per school at runtime in
# System Configuration → Branding.
PRIMARY_COLOR="#D10000"
SECONDARY_COLOR="#1A1A1A"

# ── School identity (optional — seed + defaults) ─────────────────────────
# Used by `npm run db:seed` to create the school row. Per-school values are
# edited later at System Configuration → Branding (stored in the database).
SCHOOL_NAME="My School"
SCHOOL_LOGO=""
SCHOOL_EMAIL="admin@myschool.example"
SCHOOL_PHONE=""
SCHOOL_ADDRESS=""
SCHOOL_CITY=""
SCHOOL_WEBSITE=""

# ── Seed accounts (REQUIRED for `npm run db:seed` in production) ─────────
# In development these fall back to admin@example.com / admin123.
# In production (NODE_ENV=production) the seed refuses to run unless both
# ADMIN_EMAIL and ADMIN_PASSWORD are set explicitly.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"

# ── Email (optional — Resend) ────────────────────────────────────────────
# Without these, transactional email is not sent.
RESEND_API_KEY=""
EMAIL_FROM="SchoolOS <noreply@your-school.example>"

# ── Demo instance ONLY (never set on a customer installation) ────────────
# DEMO_MODE=true enables demo accounts and allows `npm run demo:reset`
# (the nightly wipe). demo:reset refuses to run unless NODE_ENV is not
# production AND DEMO_MODE=true.
DEMO_MODE=""
DEMO_ADMIN_EMAIL="demo@schoolos.demo"
DEMO_ADMIN_PASSWORD=""
# Shows a banner across the demo UI (NEXT_PUBLIC_ = visible in the browser)
NEXT_PUBLIC_DEMO_BANNER=""

# ── Node (usually set by the host, do not commit a real value) ───────────
# NODE_ENV="development"
